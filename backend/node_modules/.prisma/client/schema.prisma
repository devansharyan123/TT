generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  email_password
  google
  phone
}

enum TaskType {
  timed
  quantity
}

enum TimerState {
  idle
  running
  paused
  break
  done
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  phone       String?  @unique
  displayName String?
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts      AuthAccount[]
  sections      TaskSection[]
  tasks         Task[]
  streaks       SectionStreak[]
  dailyMetrics  DailyMetric[]
  taskMetrics   TaskMetricDaily[]
  analytics     AnalyticsEvent[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  passwordHash   String?
  isVerified     Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model TaskSection {
  id         String   @id @default(cuid())
  userId     String
  name       String
  color      String?
  icon       String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]
  streaks      SectionStreak[]
  dailyMetrics DailyMetric[]
  taskMetrics  TaskMetricDaily[]
  analytics    AnalyticsEvent[]

  @@unique([userId, name])
  @@index([userId, isArchived])
}

model Task {
  id               String     @id @default(cuid())
  userId           String
  sectionId        String
  title            String
  type             TaskType
  allocatedMinutes Int?
  elapsedSeconds   Int        @default(0)
  timerState       TimerState @default(idle)
  targetQuantity   Int?
  currentQuantity  Int        @default(0)
  unit             String?
  scheduledTime    String?
  endTime          String?
  tags             String[]   @default([])
  completed        Boolean    @default(false)
  date             DateTime
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  section TaskSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([userId, sectionId, date])
  @@index([sectionId, date])
  @@index([sectionId, title])
}

model SectionStreak {
  id                     String    @id @default(cuid())
  userId                 String
  sectionId              String
  current                Int       @default(0)
  best                   Int       @default(0)
  streakSaves            Int       @default(0)
  consecutiveSuccessDays Int       @default(0)
  lastSaveUsedDate       DateTime?
  updatedAt              DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  section TaskSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])
  @@index([sectionId])
}

model DailyMetric {
  id                 String   @id @default(cuid())
  userId             String
  sectionId          String
  date               DateTime
  totalTasks         Int      @default(0)
  completedTasks     Int      @default(0)
  completionPercent  Int      @default(0)
  success            Boolean  @default(false)
  saveUsed           Boolean  @default(false)
  previousDayPercent Int?
  createdAt          DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  section TaskSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, date])
  @@index([userId, date])
}

model TaskMetricDaily {
  id                String   @id @default(cuid())
  userId            String
  sectionId         String
  taskTitle         String
  taskType          TaskType
  date              DateTime
  completionPercent Int      @default(0)
  targetValue       Int?
  actualValue       Int?
  createdAt         DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  section TaskSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, taskTitle, date])
  @@index([sectionId, date])
}

model AnalyticsEvent {
  id            BigInt   @id @default(autoincrement())
  userId        String?
  sectionId     String?
  eventName     String
  eventCategory String?
  path          String?
  sessionId     String?
  metadata      Json?
  userAgent     String?
  ipHash        String?
  eventAt       DateTime @default(now())

  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  section TaskSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([eventName, eventAt])
  @@index([userId, eventAt])
  @@index([sectionId, eventAt])
}
